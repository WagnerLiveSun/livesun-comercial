# mysql ou postgresql
DB_ENGINE=mysql

# Hostinger / MySQL
# Alias aceitos: DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME, DB_TYPE
MYSQL_HOST=seu-host-mysql-hostinger
MYSQL_PORT=3306
MYSQL_DATABASE=nome_do_banco_mysql
MYSQL_USER=usuario_mysql
MYSQL_PASSWORD=senha_mysql

# MontuDB / PostgreSQL
# Em desenvolvimento local, o tunel SSH (externo a esta aplicacao) expoe o banco em 127.0.0.1:55432.
# Nao use wagner.montudb.com como host da aplicacao.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DATABASE=comercial
POSTGRES_USER=livesun_api
POSTGRES_PASSWORD=defina_em_arquivo_local_nao_versionado

# Habilita a aplicacao do contexto RLS quando o banco for PostgreSQL.
POSTGRES_RLS_ENABLED=true

SECRET_KEY=altere-esta-chave
FLASK_ENV=development
