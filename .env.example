# Flask Configuration
FLASK_ENV=production
FLASK_APP=src/app.py
FLASK_DEBUG=False
SECRET_KEY=sua-chave-secreta-mude-em-producao

# Database Configuration - MySQL (Local)
# Para desenvolvimento local
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=comercial

